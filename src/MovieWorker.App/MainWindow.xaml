<Window x:Class="MovieWorker.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MovieWorker.App.ViewModels"
        xmlns:c="clr-namespace:MovieWorker.App.Controls"
        Title="{Binding WindowTitle}" Width="1440" Height="900" MinWidth="1000" MinHeight="650"
        WindowStartupLocation="CenterScreen" AllowDrop="True">
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewProjectCommand}" />
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenProjectCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveProjectCommand}" />
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveProjectAsCommand}" />
        <KeyBinding Key="I" Modifiers="Control" Command="{Binding ImportFilesCommand}" />
        <KeyBinding Key="E" Modifiers="Control" Command="{Binding ExportCommand}" />
        <KeyBinding Key="D" Modifiers="Control" Command="{Binding AddDefaultTransitionCommand}" />
        <KeyBinding Key="C" Modifiers="Control+Alt" Command="{Binding CopyGradeCommand}" />
        <KeyBinding Key="V" Modifiers="Control+Alt" Command="{Binding PasteGradeCommand}" />
        <KeyBinding Key="T" Modifiers="Control+Shift" Command="{Binding AddTitleFromMenuCommand}" CommandParameter="Headline" />
        <KeyBinding Key="E" Modifiers="Control+Shift" Command="{Binding ExportStillCommand}" />
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />
    </Window.InputBindings>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Datei">
                <MenuItem Header="_Neues Projekt" InputGestureText="Strg+N" Command="{Binding NewProjectCommand}" />
                <MenuItem Header="Projekt ö_ffnen …" InputGestureText="Strg+O" Command="{Binding OpenProjectCommand}" />
                <MenuItem Header="_Zuletzt geöffnet" ItemsSource="{Binding RecentProjects}" Click="OnRecentClick">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem">
                            <Setter Property="Header" Value="{Binding}" />
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <Separator />
                <MenuItem Header="_Speichern" InputGestureText="Strg+S" Command="{Binding SaveProjectCommand}" />
                <MenuItem Header="Speichern _unter …" InputGestureText="Strg+Umschalt+S" Command="{Binding SaveProjectAsCommand}" />
                <Separator />
                <MenuItem Header="Dateien _importieren …" InputGestureText="Strg+I" Command="{Binding ImportFilesCommand}" />
                <MenuItem Header="Speicher_karte importieren …" Command="{Binding ImportCardCommand}" />
                <Separator />
                <MenuItem Header="_Exportieren …" InputGestureText="Strg+E" Command="{Binding ExportCommand}" />
                <MenuItem Header="Einzel_bild exportieren …" InputGestureText="Strg+Umschalt+E" Command="{Binding ExportStillCommand}" />
                <Separator />
                <MenuItem Header="_Projekteinstellungen …" Command="{Binding EditProjectSettingsCommand}" />
                <Separator />
                <MenuItem Header="_Beenden" Click="OnExitClick" />
            </MenuItem>
            <MenuItem Header="_Bearbeiten">
                <MenuItem Header="_Rückgängig" InputGestureText="Strg+Z" Command="{Binding UndoCommand}" />
                <MenuItem Header="_Wiederholen" InputGestureText="Strg+Y" Command="{Binding RedoCommand}" />
                <Separator />
                <MenuItem Header="Am Abspielkopf _teilen" InputGestureText="Strg+B" Command="{Binding SplitAtPlayheadCommand}" />
                <MenuItem Header="Clip _löschen" InputGestureText="Entf" Command="{Binding DeleteSelectedClipCommand}" />
                <MenuItem Header="Löschen und Lücke _schließen" InputGestureText="Umschalt+Entf" Command="{Binding RippleDeleteSelectedClipCommand}" />
                <Separator />
                <MenuItem Header="_In-Marke setzen" InputGestureText="I" Command="{Binding MarkInCommand}" />
                <MenuItem Header="_Out-Marke setzen" InputGestureText="O" Command="{Binding MarkOutCommand}" />
                <MenuItem Header="Marken _entfernen" InputGestureText="Strg+Umschalt+X" Command="{Binding ClearMarksCommand}" />
                <Separator />
                <MenuItem Header="_Einrasten" InputGestureText="N" IsCheckable="True" IsChecked="{Binding Snapping}" />
                <MenuItem Header="Videospur hinzufügen" Command="{Binding AddVideoTrackCommand}" />
                <Separator />
                <MenuItem Header="_Multicam-Clip aus markierten Aufnahmen" Command="{Binding CreateMulticamCommand}" />
                <MenuItem Header="Kamera wechseln" InputGestureText="1 … 9" IsEnabled="False" />
                <Separator />
                <MenuItem Header="_Verschachteln (In/Out oder Clip) …" Command="{Binding NestCommand}" />
                <MenuItem Header="Verschachtelung _auflösen" Command="{Binding UnnestCommand}" />
                <Separator />
                <MenuItem Header="Neuer _Ordner im Medienpool …" Command="{Binding NewBinCommand}" />
                <MenuItem Header="Externen Ton _automatisch synchronisieren" Command="{Binding AutoSyncAllCommand}" />
                <MenuItem Header="Tonspur hinzufügen" Command="{Binding AddAudioTrackCommand}" />
            </MenuItem>
            <MenuItem Header="_Schnitt">
                <MenuItem Header="_Einfügen (Ripple)" InputGestureText="F9" Click="OnEditMenu" Tag="Insert" />
                <MenuItem Header="Ü_berschreiben" InputGestureText="F10" Click="OnEditMenu" Tag="Overwrite" />
                <MenuItem Header="E_rsetzen" InputGestureText="F11" Click="OnEditMenu" Tag="Replace" />
                <MenuItem Header="_Oben platzieren" InputGestureText="F12" Click="OnEditMenu" Tag="PlaceOnTop" />
                <MenuItem Header="_Anhängen" InputGestureText="Umschalt+F12" Click="OnEditMenu" Tag="Append" />
                <Separator />
                <MenuItem Header="_Quellband" IsCheckable="True" IsChecked="{Binding SourceTapeMode}" />
                <MenuItem Header="_Doppel-Timeline" IsCheckable="True" IsChecked="{Binding ShowOverview}" />
            </MenuItem>
            <MenuItem Header="_Titel">
                <MenuItem Header="Überschrift" InputGestureText="Strg+Umschalt+T" Command="{Binding AddTitleFromMenuCommand}" CommandParameter="Headline" />
                <MenuItem Header="Untertitel" Command="{Binding AddTitleFromMenuCommand}" CommandParameter="Subtitle" />
                <MenuItem Header="Bauchbinde (Name + Funktion)" Command="{Binding AddTitleFromMenuCommand}" CommandParameter="LowerThird" />
                <MenuItem Header="Einblendung (Ort, Datum)" Command="{Binding AddTitleFromMenuCommand}" CommandParameter="Caption" />
                <MenuItem Header="Abspann (rollend)" Command="{Binding AddTitleFromMenuCommand}" CommandParameter="Credits" />
                <Separator />
                <MenuItem Header="Kreuzblende am nächsten Schnitt" InputGestureText="Strg+D" Command="{Binding AddDefaultTransitionCommand}" />
            </MenuItem>
            <MenuItem Header="_Wiedergabe">
                <MenuItem Header="Abspielen / Pause" InputGestureText="Leertaste" Click="OnPlayPause" />
                <MenuItem Header="Rückwärts / Stopp / Vorwärts" InputGestureText="J / K / L" IsEnabled="False" />
                <Separator />
                <MenuItem Header="Vorschau mit _Proxys" IsCheckable="True" IsChecked="{Binding UseProxies}" />
                <MenuItem Header="Proxys beim Import _automatisch erstellen" IsCheckable="True" IsChecked="{Binding AutoCreateProxies}" />
                <MenuItem Header="Proxy für Auswahl erstellen" Command="{Binding CreateProxyForSelectedCommand}" />
                <MenuItem Header="Alle fehlenden Proxys erstellen" Command="{Binding CreateAllProxiesCommand}" />
            </MenuItem>
            <MenuItem Header="_Farbe">
                <MenuItem Header="Farbkorrektur _kopieren" InputGestureText="Strg+Alt+C" Command="{Binding CopyGradeCommand}" />
                <MenuItem Header="Farbkorrektur _einfügen" InputGestureText="Strg+Alt+V" Command="{Binding PasteGradeCommand}" />
                <MenuItem Header="Auf alle Clips dieser _Kamera übertragen" Command="{Binding ApplyGradeToCameraFromMenuCommand}" />
                <Separator />
                <MenuItem Header="Als Farb_referenz merken" Command="{Binding SetGradeReferenceCommand}" />
                <MenuItem Header="An Referenz _angleichen (70D ↔ R6)" Command="{Binding MatchToReferenceCommand}" />
                <Separator />
                <MenuItem Header="_LUT-Ordner festlegen …" Command="{Binding SetLutFolderCommand}" />
            </MenuItem>
            <MenuItem Header="_Ton">
                <MenuItem Header="_Mischpult" Click="ShowMixer_Click" />
                <MenuItem Header="_Lautheit messen" Command="{Binding Mixer.MeasureLoudnessCommand}" />
                <Separator />
                <MenuItem Header="Spur des Clips bei _Sprache absenken (Ducking)" Command="{Binding DuckSelectedTrackCommand}" />
            </MenuItem>
            <MenuItem Header="_Extras">
                <MenuItem Header="_FFmpeg-Ordner festlegen …" Command="{Binding SetFfmpegFolderCommand}" />
            </MenuItem>
            <MenuItem Header="_Hilfe">
                <MenuItem Header="_Kameraprofile" Command="{Binding ShowCameraProfilesCommand}" />
                <MenuItem Header="Ü_ber MovieWorker" Command="{Binding ShowAboutCommand}" />
            </MenuItem>
        </Menu>

        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button Content="Speicherkarte importieren" Command="{Binding ImportCardCommand}" />
                <Button Content="Dateien importieren" Command="{Binding ImportFilesCommand}" />
                <Separator />
                <Button Content="Speichern" Command="{Binding SaveProjectCommand}" />
                <Button Content="Exportieren" FontWeight="SemiBold" Command="{Binding ExportCommand}" />
                <Separator />
                <Button Content="↶" ToolTip="Rückgängig (Strg+Z)" Command="{Binding UndoCommand}" />
                <Button Content="↷" ToolTip="Wiederholen (Strg+Y)" Command="{Binding RedoCommand}" />
            </ToolBar>
        </ToolBarTray>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" />
            </StatusBarItem>
            <StatusBarItem Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <ProgressBar Width="140" Height="12" Maximum="1" Value="{Binding BusyProgress}" />
                    <TextBlock Margin="6,0,0,0" Text="{Binding BusyText}" />
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding ProjectSettingsText}" />
                    <TextBlock Margin="12,0,0,0" Text="{Binding DurationText, StringFormat='Länge {0}'}" />
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="200" />
                <RowDefinition Height="5" />
                <RowDefinition Height="300" MinHeight="150" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="200" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" MinWidth="300" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="340" MinWidth="220" />
            </Grid.ColumnDefinitions>

            <!-- Medienpool -->
            <DockPanel Grid.Row="0" Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Margin="8,6,8,2" FontWeight="SemiBold" Text="Medienpool" />
                <StackPanel DockPanel.Dock="Top" Margin="6,0,6,4">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="🗑" Width="26" Margin="2,0,0,0" ToolTip="Ordner löschen" Command="{Binding DeleteBinCommand}" />
                        <Button DockPanel.Dock="Right" Content="✎" Width="26" Margin="2,0,0,0" ToolTip="Ordner umbenennen" Command="{Binding RenameBinCommand}" />
                        <Button DockPanel.Dock="Right" Content="+" Width="26" Margin="2,0,0,0" ToolTip="Neuer Ordner" Command="{Binding NewBinCommand}" />
                        <ComboBox ItemsSource="{Binding Bins}" SelectedItem="{Binding SelectedBin}" ToolTip="Ordner" />
                    </DockPanel>
                    <DockPanel Margin="0,4,0,0">
                        <TextBlock DockPanel.Dock="Left" Text="🔍" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Suchen in Name, Schlagwörtern, Notizen, Szene und Take" />
                    </DockPanel>
                    <UniformGrid Columns="3" Margin="0,4,0,0">
                        <ComboBox ItemsSource="{Binding KindFilters}" SelectedIndex="{Binding KindFilter}" Margin="0,0,2,0" />
                        <ComboBox ItemsSource="{Binding RatingFilters}" SelectedIndex="{Binding MinRatingFilter}" Margin="1,0" />
                        <ComboBox ItemsSource="{Binding SortModes}" SelectedIndex="{Binding SortMode}" Margin="2,0,0,0" ToolTip="Sortierung" />
                    </UniformGrid>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="6">
                    <Button Content="In Timeline einfügen" Padding="8,2" Command="{Binding AddSelectedToTimelineCommand}" />
                    <Button Content="Multicam" Padding="8,2" Margin="6,0,0,0" Command="{Binding CreateMulticamCommand}"
                            ToolTip="Markierte Kameraaufnahmen (Strg+Klick) per Ton synchronisieren und als Multicam-Clip anhängen" />
                    <Button Content="Proxy" Padding="8,2" Margin="6,0,0,0" ToolTip="Proxy für flüssige Vorschau erstellen"
                            Command="{Binding CreateProxyForSelectedCommand}" />
                    <Button Content="Entfernen" Padding="8,2" Margin="6,0,0,0" Command="{Binding RemoveSelectedMediaCommand}" />
                </StackPanel>
                <Grid>
                    <ListBox x:Name="MediaList" ItemsSource="{Binding MediaView}" SelectedItem="{Binding SelectedMedia}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="OnMediaDoubleClick"
                             PreviewMouseLeftButtonDown="OnMediaMouseDown" PreviewMouseMove="OnMediaMouseMove"
                             SelectionMode="Extended" SelectionChanged="OnMediaSelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:MediaItemViewModel}">
                                <Grid Margin="2,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="128" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="120" Height="68" Background="#222" CornerRadius="2">
                                        <Grid>
                                            <TextBlock Text="{Binding KindIcon}" Foreground="#888" FontSize="22"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                                            <Border Background="#B0000000" HorizontalAlignment="Right" VerticalAlignment="Bottom" Padding="3,0">
                                                <TextBlock Text="{Binding DurationText}" Foreground="White" FontSize="10" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding CameraLabel}" FontSize="11" Foreground="#555" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Stars}" FontSize="11" Foreground="#C88A00" />
                                            <TextBlock Text="{Binding SceneTakeText}" FontSize="11" Foreground="#555" Margin="6,0,0,0" />
                                            <TextBlock Text=" 🔗" FontSize="11" ToolTip="Mit externem Ton synchronisiert"
                                                       Visibility="{Binding HasSync, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                        <WrapPanel Margin="0,2,0,0">
                                            <Border Style="{StaticResource Badge}" Background="#FFE9C8"
                                                    Visibility="{Binding HasSpecialTransfer, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="{Binding TransferLabel}" FontSize="10" Foreground="#8A4B00" />
                                            </Border>
                                            <Border Style="{StaticResource Badge}" Background="#DDE8FF"
                                                    Visibility="{Binding IsHighFrameRate, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="Zeitlupe" FontSize="10" Foreground="#24489A" />
                                            </Border>
                                            <Border Style="{StaticResource Badge}" Background="#DFF3E4"
                                                    Visibility="{Binding HasProxy, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="Proxy" FontSize="10" Foreground="#1E6B35" />
                                            </Border>
                                        </WrapPanel>
                                        <ProgressBar Height="4" Maximum="1" Value="{Binding ProxyProgress}" Margin="0,3,0,0"
                                                     Visibility="{Binding IsProxyRunning, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="Speicherkarte importieren oder Dateien hierher ziehen."
                               Style="{StaticResource Hint}" Margin="20" TextAlignment="Center" VerticalAlignment="Center"
                               IsHitTestVisible="False" x:Name="EmptyPoolHint" />
                </Grid>
            </DockPanel>

            <GridSplitter Grid.Row="0" Grid.Column="1" Width="5" HorizontalAlignment="Stretch" />

            <!-- Monitore -->
            <Grid Grid.Row="0" Grid.Column="2" x:Name="MonitorHost" Background="#111">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <c:SourceMonitor x:Name="SourceMonitor" Grid.Column="0" />
                <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#333" />
                <c:ProgramMonitor x:Name="ProgramMonitor" Grid.Column="2" />
            </Grid>

            <GridSplitter Grid.Row="0" Grid.Column="3" Width="5" HorizontalAlignment="Stretch" />

            <!-- Inspektor -->
            <TabControl Grid.Row="0" Grid.Column="4" x:Name="Inspector">
                <TabItem Header="Clip" x:Name="ClipTab">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <TextBlock Text="Klicke einen Clip in der Timeline an." Style="{StaticResource Hint}" Margin="8"
                                       Visibility="{Binding SelectedClip, Converter={StaticResource NullToVisibility}, ConverterParameter=invert}" />
                            <StackPanel Margin="8" DataContext="{Binding SelectedClip}"
                                        Visibility="{Binding Converter={StaticResource NullToVisibility}}">
                                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding TrackName}" Style="{StaticResource Hint}" />
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Anfang" Foreground="#666" />
                                    <TextBlock Grid.Column="1" Text="{Binding StartText}" FontFamily="Consolas" />
                                    <TextBlock Grid.Row="1" Text="Ende" Foreground="#666" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding EndText}" FontFamily="Consolas" />
                                    <TextBlock Grid.Row="2" Text="Länge" Foreground="#666" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LengthText}" FontFamily="Consolas" />
                                    <TextBlock Grid.Row="3" Text="Aus Quelle" Foreground="#666" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SourceText}" />
                                </Grid>

                                <StackPanel DataContext="{Binding Title}" Visibility="{Binding Converter={StaticResource NullToVisibility}}">
                                    <TextBlock Text="Titel" Style="{StaticResource SectionHeader}" />
                                    <TextBox Text="{Binding Text, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="54"
                                             ToolTip="Jede Zeile wird eine eigene Textzeile (Bauchbinde: 1. Zeile Name, 2. Zeile Funktion)" />
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Vorlage" VerticalAlignment="Center" />
                                        <ComboBox Grid.Column="1" Margin="0,2" ItemsSource="{Binding Source={x:Static vm:TitleViewModel.Styles}}" SelectedItem="{Binding Style}" />
                                        <TextBlock Grid.Row="1" Text="Schrift" VerticalAlignment="Center" />
                                        <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,2">
                                            <CheckBox DockPanel.Dock="Right" Content="fett" IsChecked="{Binding Bold}" VerticalAlignment="Center" Margin="6,0,0,0" />
                                            <ComboBox ItemsSource="{Binding Source={x:Static vm:TitleViewModel.Fonts}}" SelectedItem="{Binding FontFamily}" />
                                        </DockPanel>
                                        <TextBlock Grid.Row="2" Text="Größe" VerticalAlignment="Center" />
                                        <Slider Grid.Row="2" Grid.Column="1" Margin="0,2" Minimum="2" Maximum="25" Value="{Binding SizePercent}" />
                                        <TextBlock Grid.Row="3" Text="Farbe" VerticalAlignment="Center" />
                                        <ComboBox Grid.Row="3" Grid.Column="1" Margin="0,2" ItemsSource="{Binding Source={x:Static vm:TitleViewModel.Colors}}" SelectedItem="{Binding Color}" />
                                        <TextBlock Grid.Row="4" Text="Kasten" VerticalAlignment="Center" />
                                        <DockPanel Grid.Row="4" Grid.Column="1" Margin="0,2">
                                            <CheckBox DockPanel.Dock="Left" IsChecked="{Binding Box}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <Slider Minimum="0" Maximum="100" Value="{Binding BoxOpacity}" IsEnabled="{Binding Box}" ToolTip="Deckkraft des Kastens" />
                                        </DockPanel>
                                        <TextBlock Grid.Row="5" Text="Ausrichtung" VerticalAlignment="Center" />
                                        <ComboBox Grid.Row="5" Grid.Column="1" Margin="0,2" ItemsSource="{Binding Source={x:Static vm:TitleViewModel.Aligns}}" SelectedItem="{Binding Align}" />
                                        <TextBlock Grid.Row="6" Text="Position X" VerticalAlignment="Center" />
                                        <Slider Grid.Row="6" Grid.Column="1" Margin="0,2" Minimum="0" Maximum="100" Value="{Binding PositionX}" />
                                        <TextBlock Grid.Row="7" Text="Position Y" VerticalAlignment="Center" />
                                        <Slider Grid.Row="7" Grid.Column="1" Margin="0,2" Minimum="0" Maximum="100" Value="{Binding PositionY}" />
                                        <TextBlock Grid.Row="8" Text="Animation rein" VerticalAlignment="Center" />
                                        <ComboBox Grid.Row="8" Grid.Column="1" Margin="0,2" ItemsSource="{Binding Source={x:Static vm:TitleViewModel.Animations}}" SelectedItem="{Binding AnimationIn}" />
                                        <TextBlock Grid.Row="9" Text="Animation raus" VerticalAlignment="Center" />
                                        <ComboBox Grid.Row="9" Grid.Column="1" Margin="0,2" ItemsSource="{Binding Source={x:Static vm:TitleViewModel.Animations}}" SelectedItem="{Binding AnimationOut}" />
                                        <TextBlock Grid.Row="10" Text="Dauer (s)" VerticalAlignment="Center" />
                                        <TextBox Grid.Row="10" Grid.Column="1" Margin="0,2" Text="{Binding AnimationSeconds, UpdateSourceTrigger=LostFocus}" />
                                    </Grid>
                                </StackPanel>

                                <StackPanel Visibility="{Binding IsMulticam, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Multicam" Style="{StaticResource SectionHeader}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition /><RowDefinition />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Bild von" VerticalAlignment="Center" />
                                        <ComboBox Grid.Column="1" Margin="0,2" ItemsSource="{Binding Angles}" SelectedItem="{Binding ActiveAngle}" />
                                        <TextBlock Grid.Row="1" Text="Ton von" VerticalAlignment="Center" />
                                        <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,2" ItemsSource="{Binding Angles}" SelectedItem="{Binding AudioAngle}" />
                                    </Grid>
                                    <TextBlock Style="{StaticResource Hint}" Text="Kamerawechsel am Abspielkopf mit den Tasten 1, 2, 3 … – auch während der Wiedergabe (Live-Schnitt)." />
                                </StackPanel>

                                <StackPanel Visibility="{Binding IsVideoMediaClip, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Bild-in-Bild &amp; Zuschnitt" Style="{StaticResource SectionHeader}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4" Visibility="{Binding IsOverlayClip, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="Ecke:" VerticalAlignment="Center" Margin="0,0,4,0" />
                                        <Button Content="↖" Width="24" Command="{Binding PipPresetCommand}" CommandParameter="TL" />
                                        <Button Content="↗" Width="24" Command="{Binding PipPresetCommand}" CommandParameter="TR" />
                                        <Button Content="↙" Width="24" Command="{Binding PipPresetCommand}" CommandParameter="BL" />
                                        <Button Content="↘" Width="24" Command="{Binding PipPresetCommand}" CommandParameter="BR" />
                                    </StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Mischmodus" VerticalAlignment="Center" Visibility="{Binding IsOverlayClip, Converter={StaticResource BoolToVisibility}}" />
                                        <ComboBox Grid.Column="1" Margin="0,2" ItemsSource="{Binding Source={x:Static vm:ClipViewModel.BlendModes}}" SelectedItem="{Binding Blend}"
                                                  Visibility="{Binding IsOverlayClip, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Grid.Row="1" Text="Links" VerticalAlignment="Center" />
                                        <Slider Grid.Row="1" Grid.Column="1" Margin="0,2" Minimum="0" Maximum="45" Value="{Binding CropLeft}" />
                                        <TextBlock Grid.Row="2" Text="Rechts" VerticalAlignment="Center" />
                                        <Slider Grid.Row="2" Grid.Column="1" Margin="0,2" Minimum="0" Maximum="45" Value="{Binding CropRight}" />
                                        <TextBlock Grid.Row="3" Text="Oben" VerticalAlignment="Center" />
                                        <Slider Grid.Row="3" Grid.Column="1" Margin="0,2" Minimum="0" Maximum="45" Value="{Binding CropTop}" />
                                        <TextBlock Grid.Row="4" Text="Unten" VerticalAlignment="Center" />
                                        <Slider Grid.Row="4" Grid.Column="1" Margin="0,2" Minimum="0" Maximum="45" Value="{Binding CropBottom}" />
                                        <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,2">
                                            <CheckBox Content="waagerecht spiegeln" IsChecked="{Binding FlipHorizontal}" Margin="0,0,8,0" />
                                            <CheckBox Content="senkrecht" IsChecked="{Binding FlipVertical}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>

                                <StackPanel Visibility="{Binding IsVideoMediaClip, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Übergang vom vorherigen Clip" Style="{StaticResource SectionHeader}" />
                                    <DockPanel>
                                        <TextBox DockPanel.Dock="Right" Width="46" Margin="4,0,0,0" Text="{Binding TransitionSeconds, UpdateSourceTrigger=LostFocus}"
                                                 IsEnabled="{Binding HasTransition}" ToolTip="Dauer in Sekunden" />
                                        <ComboBox ItemsSource="{Binding Source={x:Static vm:ClipViewModel.TransitionChoices}}" SelectedItem="{Binding SelectedTransition}" />
                                    </DockPanel>
                                </StackPanel>

                                <StackPanel Visibility="{Binding IsMediaClip, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Geschwindigkeit" Style="{StaticResource SectionHeader}" />
                                <ComboBox ItemsSource="{Binding SpeedChoices}" SelectedItem="{Binding SelectedSpeed}" />
                                <Button Content="{Binding ConformText}" Margin="0,4,0,0" Padding="6,2" HorizontalAlignment="Left"
                                        Command="{Binding ConformCommand}"
                                        Visibility="{Binding CanConform, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="{Binding LastError}" Foreground="#B03030" TextWrapping="Wrap"
                                           Visibility="{Binding LastError, Converter={StaticResource NullToVisibility}}" />

                                <TextBlock Text="{Binding NestedText}" Foreground="#6A43B5" TextWrapping="Wrap"
                                           Visibility="{Binding IsNested, Converter={StaticResource BoolToVisibility}}" />

                                <TextBlock Text="Geschwindigkeitsrampe" Style="{StaticResource SectionHeader}" />
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Anwenden" Padding="6,0" Margin="4,0,0,0" Command="{Binding ApplyRampCommand}" />
                                    <ComboBox DockPanel.Dock="Right" Width="64" ItemsSource="{Binding RampSpeeds}" SelectedIndex="{Binding RampSpeed}" Margin="4,0,0,0" />
                                    <ComboBox ItemsSource="{Binding RampShapes}" SelectedIndex="{Binding RampShape}" />
                                </DockPanel>

                                <TextBlock Text="Bewegung (Keyframes am Abspielkopf)" Style="{StaticResource SectionHeader}"
                                           Visibility="{Binding IsVideoClip, Converter={StaticResource BoolToVisibility}}" />
                                <ItemsControl ItemsSource="{Binding Motion}"
                                              Visibility="{Binding IsVideoClip, Converter={StaticResource BoolToVisibility}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,1">
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Label}" Width="72" VerticalAlignment="Center" />
                                                <Button DockPanel.Dock="Right" Content="↺" Width="20" Command="{Binding ResetCommand}" ToolTip="Zurücksetzen" />
                                                <Button DockPanel.Dock="Right" Content="▶" Width="18" Command="{Binding NextKeyCommand}" ToolTip="Nächster Keyframe" />
                                                <Button DockPanel.Dock="Right" Content="{Binding KeySymbol}" Width="22" Foreground="#C88A00"
                                                        Command="{Binding ToggleKeyCommand}" ToolTip="{Binding KeyToolTip}" />
                                                <Button DockPanel.Dock="Right" Content="◀" Width="18" Command="{Binding PreviousKeyCommand}" ToolTip="Vorheriger Keyframe" />
                                                <TextBox DockPanel.Dock="Right" Width="48" Text="{Binding Value, StringFormat='{}{0:0.#}', UpdateSourceTrigger=LostFocus}"
                                                         Margin="2,0" />
                                                <Slider Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" Value="{Binding Value}" VerticalAlignment="Center" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="Ton" Style="{StaticResource SectionHeader}" />
                                <DockPanel DataContext="{Binding VolumeKeys}" Margin="0,0,0,2">
                                    <TextBlock DockPanel.Dock="Left" Text="Hüllkurve" Width="72" VerticalAlignment="Center" />
                                    <Button DockPanel.Dock="Right" Content="▶" Width="18" Command="{Binding NextKeyCommand}" ToolTip="Nächster Keyframe" />
                                    <Button DockPanel.Dock="Right" Content="{Binding KeySymbol}" Width="22" Foreground="#C88A00"
                                            Command="{Binding ToggleKeyCommand}" ToolTip="Lautstärke-Keyframe setzen/löschen" />
                                    <Button DockPanel.Dock="Right" Content="◀" Width="18" Command="{Binding PreviousKeyCommand}" ToolTip="Vorheriger Keyframe" />
                                    <TextBlock Text="{Binding Value, StringFormat='{}{0:+0.0;-0.0;0.0} dB am Abspielkopf'}" VerticalAlignment="Center" />
                                </DockPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Width="60" TextAlignment="Right"
                                               Text="{Binding VolumeDb, StringFormat='{}{0:+0.0;-0.0;0.0} dB'}" />
                                    <Slider Minimum="-40" Maximum="12" Value="{Binding VolumeDb}" SmallChange="0.5" LargeChange="3"
                                            IsEnabled="{Binding HasAudio}" />
                                </DockPanel>
                                <CheckBox Content="Ton stumm" IsChecked="{Binding AudioMuted}" IsEnabled="{Binding HasAudio}" Margin="0,4,0,0" />

                                <TextBlock Text="Blenden (Sekunden)" Style="{StaticResource SectionHeader}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition /><RowDefinition />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Einblenden" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Margin="0,2" Text="{Binding FadeInSeconds, UpdateSourceTrigger=LostFocus}" />
                                    <TextBlock Grid.Row="1" Text="Ausblenden" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,2" Text="{Binding FadeOutSeconds, UpdateSourceTrigger=LostFocus}" />
                                </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Farbe" x:Name="ColorTab">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8">
                            <TextBlock Text="Klicke einen Clip in der Timeline an, um seine Farben zu bearbeiten." Style="{StaticResource Hint}"
                                       Visibility="{Binding SelectedClip, Converter={StaticResource NullToVisibility}, ConverterParameter=invert}" />
                            <StackPanel DataContext="{Binding SelectedClip.Color}" Visibility="{Binding Converter={StaticResource NullToVisibility}}">
                                <TextBlock Text="Korrekturknoten" Style="{StaticResource SectionHeader}" />
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="−" Width="24" Margin="2,0,0,0" ToolTip="Gewählten Knoten löschen"
                                            Command="{Binding DataContext.RemoveColorNodeCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    <Menu DockPanel.Dock="Right" Margin="2,0,0,0" Background="Transparent">
                                        <MenuItem Header="+ Knoten" Padding="4,1">
                                            <MenuItem Header="Korrektur (ganzes Bild)" Command="{Binding DataContext.AddColorNodeCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="Ganz" />
                                            <MenuItem Header="Bereich mit Ellipse (z. B. Gesicht)" Command="{Binding DataContext.AddColorNodeCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="Ellipse" />
                                            <MenuItem Header="Bereich mit Rechteck" Command="{Binding DataContext.AddColorNodeCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="Rechteck" />
                                            <MenuItem Header="Vignette (Ränder abdunkeln)" Command="{Binding DataContext.AddColorNodeCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="Vignette" />
                                        </MenuItem>
                                    </Menu>
                                    <ComboBox ItemsSource="{Binding NodeChoices}" SelectedItem="{Binding SelectedNode}" />
                                </DockPanel>
                                <CheckBox Content="Knoten aktiv" IsChecked="{Binding NodeEnabled}" Margin="0,4,0,0"
                                          Visibility="{Binding IsNodeSelected, Converter={StaticResource BoolToVisibility}}" />

                                <StackPanel Visibility="{Binding IsNodeSelected, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Maske" Style="{StaticResource SectionHeader}" />
                                    <ComboBox ItemsSource="{Binding Source={x:Static vm:ColorViewModel.MaskShapes}}" SelectedItem="{Binding SelectedMaskShape}" />
                                    <Grid Margin="0,4,0,0" Visibility="{Binding HasMask, Converter={StaticResource BoolToVisibility}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="84" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Mitte X" VerticalAlignment="Center" />
                                        <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding MaskCenterX}" />
                                        <TextBlock Grid.Row="1" Text="Mitte Y" VerticalAlignment="Center" />
                                        <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding MaskCenterY}" />
                                        <TextBlock Grid.Row="2" Text="Breite" VerticalAlignment="Center" />
                                        <Slider Grid.Row="2" Grid.Column="1" Minimum="0.02" Maximum="1.5" Value="{Binding MaskWidth}" />
                                        <TextBlock Grid.Row="3" Text="Höhe" VerticalAlignment="Center" />
                                        <Slider Grid.Row="3" Grid.Column="1" Minimum="0.02" Maximum="1.5" Value="{Binding MaskHeight}" />
                                        <TextBlock Grid.Row="4" Text="Weiche Kante" VerticalAlignment="Center" />
                                        <Slider Grid.Row="4" Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding MaskFeather}" />
                                        <CheckBox Grid.Row="5" Grid.Column="1" Content="Umkehren (außen korrigieren)" IsChecked="{Binding MaskInvert}" Margin="0,2" />
                                        <DockPanel Grid.Row="6" Grid.ColumnSpan="2" Margin="0,4,0,0">
                                            <Button DockPanel.Dock="Left" Content="Verfolgen ▶" Padding="6,1"
                                                    ToolTip="Maske ab dem Abspielkopf dem Objekt folgen lassen (bis Clipende, höchstens 10 s)"
                                                    Command="{Binding DataContext.TrackMaskCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            <Button DockPanel.Dock="Left" Content="Löschen" Padding="6,1" Margin="4,0,0,0"
                                                    Command="{Binding DataContext.ClearTrackingCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            <TextBlock Text="{Binding TrackText}" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="#666" />
                                        </DockPanel>
                                    </Grid>
                                </StackPanel>

                                <TextBlock Text="Eingang" Style="{StaticResource SectionHeader}"
                                           Visibility="{Binding IsNodeSelected, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                                <ComboBox ItemsSource="{Binding Source={x:Static vm:ColorViewModel.TransformChoices}}" SelectedItem="{Binding Transform}" />
                                <DockPanel Margin="0,4,0,0" Visibility="{Binding UsesLut, Converter={StaticResource BoolToVisibility}}">
                                    <Button DockPanel.Dock="Right" Content="…" Width="28" Margin="4,0,0,0" ToolTip="LUT-Datei wählen"
                                            Command="{Binding DataContext.ChooseLutFileCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    <ComboBox ItemsSource="{Binding Luts}" SelectedItem="{Binding Lut}" ToolTip="LUTs aus dem LUT-Ordner (Menü Farbe)" />
                                </DockPanel>
                                <ComboBox Margin="0,4,0,0" ItemsSource="{Binding Source={x:Static vm:ColorViewModel.ToneMapChoices}}" SelectedItem="{Binding ToneMap}"
                                          Visibility="{Binding UsesToneMap, Converter={StaticResource BoolToVisibility}}" />

                                <TextBlock Text="Grundkorrektur" Style="{StaticResource SectionHeader}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="84" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="42" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Belichtung" VerticalAlignment="Center" />
                                    <Slider Grid.Column="1" Minimum="-3" Maximum="3" Value="{Binding Exposure}" SmallChange="0.1" />
                                    <TextBlock Grid.Column="2" Text="{Binding Exposure, StringFormat='{}{0:+0.0;-0.0;0} EV'}" TextAlignment="Right" />
                                    <TextBlock Grid.Row="1" Text="Kontrast" VerticalAlignment="Center" />
                                    <Slider Grid.Row="1" Grid.Column="1" Minimum="-100" Maximum="100" Value="{Binding Contrast}" />
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Contrast, StringFormat='{}{0:+0;-0;0}'}" TextAlignment="Right" />
                                    <TextBlock Grid.Row="2" Text="Sättigung" VerticalAlignment="Center" />
                                    <Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="200" Value="{Binding Saturation}" />
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Saturation, StringFormat='{}{0:0} %'}" TextAlignment="Right" />
                                    <TextBlock Grid.Row="3" Text="Temperatur" VerticalAlignment="Center" />
                                    <Slider Grid.Row="3" Grid.Column="1" Minimum="-100" Maximum="100" Value="{Binding Temperature}" ToolTip="links kühler, rechts wärmer" />
                                    <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding Temperature, StringFormat='{}{0:+0;-0;0}'}" TextAlignment="Right" />
                                    <TextBlock Grid.Row="4" Text="Tönung" VerticalAlignment="Center" />
                                    <Slider Grid.Row="4" Grid.Column="1" Minimum="-100" Maximum="100" Value="{Binding Tint}" ToolTip="links grüner, rechts magenta" />
                                    <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding Tint, StringFormat='{}{0:+0;-0;0}'}" TextAlignment="Right" />
                                </Grid>

                                <TextBlock Text="Farbräder" Style="{StaticResource SectionHeader}" />
                                <ItemsControl ItemsSource="{Binding Wheels}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="3" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="2">
                                                <TextBlock Text="{Binding Label}" FontSize="11" HorizontalAlignment="Center" />
                                                <c:ColorWheelControl X="{Binding X}" Y="{Binding Y}" Width="88" Height="88" Margin="0,2" />
                                                <Slider Minimum="-1" Maximum="1" Value="{Binding Master}" ToolTip="Helligkeit dieses Bereichs" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="✓ An Referenz angeglichen" Foreground="#1E6B35" Visibility="{Binding IsMatched, Converter={StaticResource BoolToVisibility}}" />

                                <TextBlock Text="Kurven" Style="{StaticResource SectionHeader}" />
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="↺" Width="24" Margin="4,0,0,0" ToolTip="Alle Kurven zurücksetzen"
                                            Command="{Binding DataContext.ResetCurvesCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    <ComboBox ItemsSource="{Binding Source={x:Static vm:ColorViewModel.CurveChannels}}" SelectedItem="{Binding SelectedCurveChannel}" />
                                </DockPanel>
                                <c:CurveEditorControl Points="{Binding CurvePoints}" CurveBrush="{Binding CurveBrush}" Margin="0,4,0,0" />

                                <TextBlock Text="Sekundäre Korrektur (Farbbereich)" Style="{StaticResource SectionHeader}" />
                                <CheckBox Content="Nur einen Farbbereich ändern (z. B. Himmel, Hauttöne)" IsChecked="{Binding SecondaryEnabled}" />
                                <Grid Margin="0,4,0,0" IsEnabled="{Binding SecondaryEnabled}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="84" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Farbton" VerticalAlignment="Center" />
                                    <Grid Grid.Column="1">
                                        <Border Height="6" VerticalAlignment="Bottom" Margin="5,0">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#FF0000" Offset="0" />
                                                    <GradientStop Color="#FFFF00" Offset="0.1667" />
                                                    <GradientStop Color="#00FF00" Offset="0.3333" />
                                                    <GradientStop Color="#00FFFF" Offset="0.5" />
                                                    <GradientStop Color="#0000FF" Offset="0.6667" />
                                                    <GradientStop Color="#FF00FF" Offset="0.8333" />
                                                    <GradientStop Color="#FF0000" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <Slider Minimum="0" Maximum="360" Value="{Binding HueCenter}" />
                                    </Grid>
                                    <TextBlock Grid.Row="1" Text="Breite" VerticalAlignment="Center" />
                                    <Slider Grid.Row="1" Grid.Column="1" Minimum="5" Maximum="180" Value="{Binding HueWidth}" />
                                    <TextBlock Grid.Row="2" Text="Min. Sättigung" VerticalAlignment="Center" />
                                    <Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding SaturationMin}" />
                                    <TextBlock Grid.Row="3" Text="Helligkeit von" VerticalAlignment="Center" />
                                    <Slider Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding LumaMin}" />
                                    <TextBlock Grid.Row="4" Text="Helligkeit bis" VerticalAlignment="Center" />
                                    <Slider Grid.Row="4" Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding LumaMax}" />
                                    <TextBlock Grid.Row="5" Text="Weichheit" VerticalAlignment="Center" />
                                    <Slider Grid.Row="5" Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding Softness}" />
                                    <CheckBox Grid.Row="6" Grid.Column="1" Content="Auswahl anzeigen (weiß = betroffen)" IsChecked="{Binding ShowSelection}" Margin="0,2" />
                                    <TextBlock Grid.Row="7" Text="→ Farbton" VerticalAlignment="Center" />
                                    <Slider Grid.Row="7" Grid.Column="1" Minimum="-90" Maximum="90" Value="{Binding SecondaryHueShift}" />
                                    <TextBlock Grid.Row="8" Text="→ Sättigung" VerticalAlignment="Center" />
                                    <Slider Grid.Row="8" Grid.Column="1" Minimum="0" Maximum="200" Value="{Binding SecondarySaturation}" />
                                    <TextBlock Grid.Row="9" Text="→ Helligkeit" VerticalAlignment="Center" />
                                    <Slider Grid.Row="9" Grid.Column="1" Minimum="-1" Maximum="1" Value="{Binding SecondaryBrightness}" />
                                </Grid>
                            </StackPanel>

                            <WrapPanel Margin="0,8,0,0" Visibility="{Binding SelectedClip, Converter={StaticResource NullToVisibility}}">
                                <Button Content="Zurücksetzen" Padding="6,1" Margin="0,0,4,4" Command="{Binding ResetGradeCommand}" />
                                <Button Content="Kopieren" Padding="6,1" Margin="0,0,4,4" Command="{Binding CopyGradeCommand}" />
                                <Button Content="Einfügen" Padding="6,1" Margin="0,0,4,4" Command="{Binding PasteGradeCommand}" />
                                <Button Content="Auf Kamera übertragen" Padding="6,1" Margin="0,0,4,4" Command="{Binding ApplyGradeToCameraFromMenuCommand}"
                                        ToolTip="Diese Korrektur auf alle Clips derselben Kamera (und Kennlinie) übertragen" />
                                <Button Content="Als Referenz" Padding="6,1" Margin="0,0,4,4" Command="{Binding SetGradeReferenceCommand}"
                                        ToolTip="Dieses Bild als Farbreferenz merken (z. B. ein R6-Mark-II-Clip)" />
                                <Button Content="An Referenz angleichen" Padding="6,1" Margin="0,0,4,4" Command="{Binding MatchToReferenceCommand}"
                                        IsEnabled="{Binding HasGradeReference}" ToolTip="Farben dieses Clips (z. B. EOS 70D) an die Referenz angleichen" />
                            </WrapPanel>

                            <TextBlock Text="Messinstrumente" Style="{StaticResource SectionHeader}" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="↻" Width="26" Margin="4,0,0,0" Command="{Binding UpdateScopesCommand}" ToolTip="Neu berechnen" />
                                <ComboBox ItemsSource="{Binding ScopeKinds}" SelectedItem="{Binding SelectedScopeChoice}" />
                            </DockPanel>
                            <Border Background="Black" Margin="0,4,0,0" Height="190">
                                <Image Source="{Binding ScopeImage}" Stretch="Fill" />
                            </Border>
                            <TextBlock Style="{StaticResource Hint}" Text="Zeigt das Bild am Abspielkopf – wird im Stillstand automatisch aktualisiert, solange dieser Reiter offen ist." />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Ton" x:Name="AudioTab">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding Mixer}">
                        <StackPanel Margin="8">
                            <TextBlock Text="Summe (Master)" Style="{StaticResource SectionHeader}" Margin="0,0,0,4" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="58" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition /><RowDefinition /><RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Lautstärke" VerticalAlignment="Center" />
                                <Slider Grid.Column="1" Margin="0,2" Minimum="-30" Maximum="12" Value="{Binding MasterVolumeDb}"
                                        SmallChange="0.5" LargeChange="3" ToolTip="Gesamtlautstärke aller Spuren" />
                                <TextBlock Grid.Column="2" Text="{Binding MasterVolumeText}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                <TextBlock Grid.Row="1" Text="Lautheit" VerticalAlignment="Center" />
                                <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,2" x:Name="LoudnessTargetBox"
                                          ItemsSource="{Binding LoudnessTargets}" SelectedItem="{Binding LoudnessTarget}"
                                          ToolTip="Beim Export wird der Ton genau auf diesen Wert gebracht (zwei Durchgänge)." />
                                <CheckBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4" Content="Limiter (nie über −0,5 dB)"
                                          IsChecked="{Binding Limiter}" />
                            </Grid>
                            <DockPanel Margin="0,4,0,0">
                                <Button DockPanel.Dock="Left" Content="Lautheit messen" Padding="8,2" Command="{Binding MeasureLoudnessCommand}"
                                        x:Name="MeasureLoudnessButton" VerticalAlignment="Top" />
                                <TextBlock Text="{Binding LoudnessText}" TextWrapping="Wrap" Margin="8,0,0,0" FontSize="11" x:Name="LoudnessResult" />
                            </DockPanel>

                            <TextBlock Text="Spuren" Style="{StaticResource SectionHeader}" />
                            <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                                       Text="M = stumm, S = solo (nur diese Spuren hören). Die Effekte wirken auf die ganze Spur – in der Vorschau hörst du Lautstärke, Panorama und Solo, beim Export alles." />
                            <ItemsControl ItemsSource="{Binding Strips}" x:Name="MixerStrips">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:MixerStripViewModel}">
                                        <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="3" Padding="6" Margin="0,4,0,2" Background="White">
                                            <StackPanel>
                                                <DockPanel>
                                                    <ToggleButton DockPanel.Dock="Right" Content="S" Width="22" Margin="2,0,0,0" IsChecked="{Binding Solo}" ToolTip="Solo" />
                                                    <ToggleButton DockPanel.Dock="Right" Content="M" Width="22" Margin="4,0,0,0" IsChecked="{Binding Muted}" ToolTip="Stumm" />
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock FontSize="11" Foreground="#666">
                                                            <Run Text="{Binding KindText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding EffectsText, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                </DockPanel>
                                                <DockPanel Margin="0,4,0,0">
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding LevelText}" Width="28" TextAlignment="Right" FontSize="11" />
                                                    <ProgressBar Height="6" Maximum="1" Value="{Binding Level, Mode=OneWay}" Foreground="#3BA55C" ToolTip="Pegel an der Abspielposition (dBFS)" />
                                                </DockPanel>
                                                <Grid Margin="0,4,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="80" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="54" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition /><RowDefinition />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Text="Lautstärke" VerticalAlignment="Center" />
                                                    <Slider Grid.Column="1" Margin="0,2" Minimum="-60" Maximum="12" Value="{Binding VolumeDb}" SmallChange="0.5" LargeChange="3" />
                                                    <TextBlock Grid.Column="2" Text="{Binding VolumeText}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                                    <TextBlock Grid.Row="1" Text="Panorama" VerticalAlignment="Center" />
                                                    <Slider Grid.Row="1" Grid.Column="1" Margin="0,2" Minimum="-1" Maximum="1" Value="{Binding Pan}" SmallChange="0.05" LargeChange="0.25" />
                                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding PanText}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                                </Grid>
                                                <Expander Header="Effekte und Ducking" Margin="0,4,0,0">
                                                    <Grid Margin="0,4,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="80" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                                        </Grid.RowDefinitions>
                                                        <TextBlock Text="Hochpass" VerticalAlignment="Center" ToolTip="Schneidet Tiefen unterhalb der Frequenz ab (Wind, Trittschall, Brummen)" />
                                                        <Slider Grid.Column="1" Margin="0,2" Minimum="0" Maximum="400" Value="{Binding HighPassHz}" SmallChange="10" LargeChange="40"
                                                                ToolTip="{Binding HighPassHz}" />
                                                        <TextBlock Grid.Row="1" Text="Entrauschen" VerticalAlignment="Center" ToolTip="Rauschminderung (Rauschen von Kamera-Vorverstärker, Lüfter, Wind)" />
                                                        <Slider Grid.Row="1" Grid.Column="1" Margin="0,2" Minimum="0" Maximum="1" Value="{Binding NoiseReduction}" SmallChange="0.05" LargeChange="0.2" />
                                                        <TextBlock Grid.Row="2" Text="EQ Tiefen" VerticalAlignment="Center" />
                                                        <Slider Grid.Row="2" Grid.Column="1" Margin="0,2" Minimum="-12" Maximum="12" Value="{Binding EqLow}" SmallChange="0.5" LargeChange="3" ToolTip="120 Hz" />
                                                        <TextBlock Grid.Row="3" Text="EQ Mitten" VerticalAlignment="Center" />
                                                        <Slider Grid.Row="3" Grid.Column="1" Margin="0,2" Minimum="-12" Maximum="12" Value="{Binding EqMid}" SmallChange="0.5" LargeChange="3" ToolTip="1 kHz" />
                                                        <TextBlock Grid.Row="4" Text="EQ Höhen" VerticalAlignment="Center" />
                                                        <Slider Grid.Row="4" Grid.Column="1" Margin="0,2" Minimum="-12" Maximum="12" Value="{Binding EqHigh}" SmallChange="0.5" LargeChange="3" ToolTip="8 kHz" />
                                                        <CheckBox Grid.Row="5" Grid.ColumnSpan="2" Margin="0,4,0,2" Content="Kompressor (gleicht Lautstärke-Schwankungen aus)" IsChecked="{Binding Compressor}" />
                                                        <TextBlock Grid.Row="6" Text="Schwelle" VerticalAlignment="Center" />
                                                        <Slider Grid.Row="6" Grid.Column="1" Margin="0,2" Minimum="-40" Maximum="0" Value="{Binding CompressorThresholdDb}" IsEnabled="{Binding Compressor}" />
                                                        <TextBlock Grid.Row="7" Text="Verhältnis" VerticalAlignment="Center" />
                                                        <Slider Grid.Row="7" Grid.Column="1" Margin="0,2" Minimum="1" Maximum="20" Value="{Binding CompressorRatio}" IsEnabled="{Binding Compressor}" />
                                                        <TextBlock Grid.Row="8" Text="Hall" VerticalAlignment="Center" />
                                                        <Slider Grid.Row="8" Grid.Column="1" Margin="0,2" Minimum="0" Maximum="1" Value="{Binding Reverb}" SmallChange="0.05" LargeChange="0.2" />
                                                        <TextBlock Grid.Row="9" Text="Ducking" VerticalAlignment="Center"
                                                                   ToolTip="Auto-Ducking: diese Spur wird automatisch leiser, solange auf der gewählten Spur Ton ist – z. B. Musik unter Sprache." />
                                                        <ComboBox Grid.Row="9" Grid.Column="1" Margin="0,2" ItemsSource="{Binding DuckOptions}" SelectedItem="{Binding DuckBy}" />
                                                        <DockPanel Grid.Row="10" Grid.Column="1">
                                                            <Button DockPanel.Dock="Right" Content="Zurücksetzen" Padding="6,0" Margin="6,2,0,2"
                                                                    Command="{Binding DataContext.ResetStripCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}" />
                                                            <Slider Margin="0,2" Minimum="3" Maximum="30" Value="{Binding DuckAmountDb}" ToolTip="Wie stark abgesenkt wird (dB)" />
                                                        </DockPanel>
                                                        <TextBlock Grid.Row="10" Text="Absenkung" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Expander>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Export" x:Name="ExportTab">
                    <DockPanel Margin="6">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                            <Button Content="Neuer Export …" Padding="8,2" Command="{Binding ExportCommand}" />
                            <Button Content="Erledigte entfernen" Padding="8,2" Margin="6,0,0,0" Command="{Binding ClearFinishedExportsCommand}" />
                        </StackPanel>
                        <Grid>
                            <TextBlock Text="Noch keine Exporte. „Exportieren“ (Strg+E) legt einen Auftrag an; mehrere Aufträge laufen nacheinander."
                                       Style="{StaticResource Hint}" Margin="4" x:Name="EmptyQueueHint" />
                            <ItemsControl ItemsSource="{Binding ExportQueue.Jobs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ExportJobViewModel}">
                                        <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="3" Padding="6" Margin="0,0,0,6" Background="White">
                                            <StackPanel>
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding StateText}" Foreground="#555" />
                                                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                                <TextBlock Text="{Binding PresetName}" FontSize="11" Foreground="#666" TextTrimming="CharacterEllipsis" />
                                                <ProgressBar Height="8" Maximum="1" Value="{Binding Progress}" Margin="0,4,0,2" />
                                                <TextBlock Text="{Binding Detail}" FontSize="11" TextWrapping="Wrap" />
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <Button Content="Abbrechen" Padding="6,0"
                                                            Command="{Binding DataContext.CancelExportCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisibility}}" />
                                                    <Button Content="Im Ordner zeigen" Padding="6,0"
                                                            Command="{Binding DataContext.ShowExportInFolderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            Visibility="{Binding IsFinished, Converter={StaticResource BoolToVisibility}}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </DockPanel>
                </TabItem>
                <TabItem Header="Aufnahme">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8" DataContext="{Binding SelectedMedia}"
                                    Visibility="{Binding Converter={StaticResource NullToVisibility}}">
                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Summary}" Style="{StaticResource Hint}" />

                            <TextBlock Text="Ordnen" Style="{StaticResource SectionHeader}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Ordner" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" Margin="0,2"
                                          ItemsSource="{Binding DataContext.TargetBins, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedItem="{Binding DataContext.SelectedMediaBin, RelativeSource={RelativeSource AncestorType=Window}}" />
                                <TextBlock Grid.Row="1" Text="Bewertung" VerticalAlignment="Center" />
                                <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,2" SelectedIndex="{Binding Rating}">
                                    <ComboBoxItem Content="☆☆☆☆☆  keine" />
                                    <ComboBoxItem Content="★☆☆☆☆" />
                                    <ComboBoxItem Content="★★☆☆☆" />
                                    <ComboBoxItem Content="★★★☆☆" />
                                    <ComboBoxItem Content="★★★★☆" />
                                    <ComboBoxItem Content="★★★★★" />
                                </ComboBox>
                                <TextBlock Grid.Row="2" Text="Szene / Take" VerticalAlignment="Center" />
                                <UniformGrid Grid.Row="2" Grid.Column="1" Columns="2" Margin="0,2">
                                    <TextBox Text="{Binding Scene, UpdateSourceTrigger=LostFocus}" Margin="0,0,2,0" ToolTip="Szene" />
                                    <TextBox Text="{Binding Take, UpdateSourceTrigger=LostFocus}" Margin="2,0,0,0" ToolTip="Take" />
                                </UniformGrid>
                                <TextBlock Grid.Row="3" Text="Schlagwörter" VerticalAlignment="Center" />
                                <TextBox Grid.Row="3" Grid.Column="1" Margin="0,2" Text="{Binding KeywordsText, UpdateSourceTrigger=LostFocus}"
                                         ToolTip="Mit Komma trennen, z. B.: Hochzeit, Kirche, Ringe" />
                                <TextBlock Grid.Row="4" Text="Notizen" VerticalAlignment="Top" Margin="0,4,0,0" />
                                <TextBox Grid.Row="4" Grid.Column="1" Margin="0,2" MinHeight="48" TextWrapping="Wrap" AcceptsReturn="True"
                                         Text="{Binding Notes, UpdateSourceTrigger=LostFocus}" />
                            </Grid>

                            <StackPanel Visibility="{Binding IsAudioOnly, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                                <TextBlock Text="Externer Ton (Rekorder)" Style="{StaticResource SectionHeader}" />
                                <TextBlock Text="{Binding SyncText}" TextWrapping="Wrap" />
                                <DockPanel Margin="0,4,0,0">
                                    <Button DockPanel.Dock="Right" Content="Synchronisieren" Padding="6,1" Margin="4,0,0,0"
                                            Command="{Binding DataContext.SyncSelectedCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    <ComboBox ItemsSource="{Binding DataContext.AudioMediaItems, RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedItem="{Binding DataContext.SelectedSyncAudio, RelativeSource={RelativeSource AncestorType=Window}}"
                                              DisplayMemberPath="Name" ToolTip="Tonaufnahme wählen, die zur selben Szene gehört" />
                                </DockPanel>
                                <StackPanel Visibility="{Binding HasSync, Converter={StaticResource BoolToVisibility}}" Margin="0,4,0,0">
                                    <CheckBox Content="Kameraton beim Einfügen stummschalten" IsChecked="{Binding ReplaceCameraAudio}" />
                                    <Button Content="Verknüpfung lösen" HorizontalAlignment="Left" Padding="6,1" Margin="0,4,0,0"
                                            Command="{Binding DataContext.RemoveSyncCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Text="Kamera" Style="{StaticResource SectionHeader}" />
                            <ComboBox ItemsSource="{Binding CameraChoices}" SelectedItem="{Binding SelectedCamera}" />
                            <TextBlock Text="{Binding CameraLabel}" Style="{StaticResource Hint}" Margin="0,2,0,0" />

                            <TextBlock Text="Hinweise für den Schnitt" Style="{StaticResource SectionHeader}"
                                       Visibility="{Binding HasHints, Converter={StaticResource BoolToVisibility}}" />
                            <Border Background="#FFF6DC" Padding="6" CornerRadius="3"
                                    Visibility="{Binding HasHints, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding HintsText}" TextWrapping="Wrap" />
                            </Border>

                            <TextBlock Text="Technische Daten" Style="{StaticResource SectionHeader}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Länge" Foreground="#666" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DurationText}" />
                                <TextBlock Grid.Row="1" Text="Kennlinie" Foreground="#666" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TransferLabel}" />
                                <TextBlock Grid.Row="2" Text="Größe" Foreground="#666" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SizeText}" />
                                <TextBlock Grid.Row="3" Text="Aufgenommen" Foreground="#666" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding CreatedText}" />
                                <TextBlock Grid.Row="4" Text="Datei(en)" Foreground="#666" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding PartsText}" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="5" Text="Ordner" Foreground="#666" />
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding FolderText}" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="6" Text="Proxy" Foreground="#666" />
                                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding ProxyText}" />
                            </Grid>

                            <TextBlock Text="Tipps zu dieser Kamera" Style="{StaticResource SectionHeader}" />
                            <TextBlock Text="{Binding CameraTipsText}" Style="{StaticResource Hint}" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <GridSplitter Grid.Row="1" Grid.ColumnSpan="5" Height="5" HorizontalAlignment="Stretch" />

            <!-- Timeline -->
            <DockPanel Grid.Row="2" Grid.ColumnSpan="5" x:Name="TimelineHost">
                <ToolBar DockPanel.Dock="Top" ToolBarTray.IsLocked="True">
                    <TextBlock Text="{Binding PlayheadText}" FontFamily="Consolas" FontSize="15" VerticalAlignment="Center" Margin="4,0,12,0" />
                    <Button Content="Teilen" ToolTip="Am Abspielkopf teilen (Strg+B)" Command="{Binding SplitAtPlayheadCommand}" />
                    <Button Content="Löschen" ToolTip="Clip löschen (Entf)" Command="{Binding DeleteSelectedClipCommand}" />
                    <Button Content="Lücke schließen" ToolTip="Löschen und Lücke schließen (Umschalt+Entf)" Command="{Binding RippleDeleteSelectedClipCommand}" />
                    <Separator />
                    <Button Content="In" ToolTip="In-Marke (I)" Command="{Binding MarkInCommand}" />
                    <Button Content="Out" ToolTip="Out-Marke (O)" Command="{Binding MarkOutCommand}" />
                    <Button Content="Marken weg" Command="{Binding ClearMarksCommand}" />
                    <Separator />
                    <ToggleButton Content="Einrasten" ToolTip="An Schnittpunkten einrasten (N)" IsChecked="{Binding Snapping}" />
                    <TextBlock Text="Ziehen:" VerticalAlignment="Center" Margin="8,0,4,0" />
                    <ComboBox ItemsSource="{Binding TrimModes}" SelectedItem="{Binding TrimMode}" Width="80"
                              ToolTip="Normal · Ripple (Rand, Rest rückt nach) · Roll (Schnittpunkt verschieben) · Slip (anderer Ausschnitt) · Slide (zwischen Nachbarn verschieben) – Tasten: A / B / R / Y / U" />
                    <Separator />
                    <Button Content="−" ToolTip="Verkleinern (−)" Click="OnZoomOut" Width="24" />
                    <Button Content="+" ToolTip="Vergrößern (+)" Click="OnZoomIn" Width="24" />
                    <Button Content="Einpassen" ToolTip="Ganze Timeline zeigen (Umschalt+Z)" Click="OnZoomFit" />
                    <Separator />
                    <ToggleButton Content="Doppel-Timeline" ToolTip="Übersicht der ganzen Timeline über der Detailansicht"
                                  IsChecked="{Binding ShowOverview}" />
                    <Separator />
                    <Button Content="+ Titel" Command="{Binding AddTitleFromMenuCommand}" CommandParameter="Headline" ToolTip="Titel am Abspielkopf (Strg+Umschalt+T)" />
                    <Button Content="Blende" Command="{Binding AddDefaultTransitionCommand}" ToolTip="Kreuzblende am nächsten Schnitt (Strg+D)" />
                    <Separator />
                    <Button Content="+ Videospur" Command="{Binding AddVideoTrackCommand}" />
                    <Button Content="+ Tonspur" Command="{Binding AddAudioTrackCommand}" />
                </ToolBar>
                <ScrollBar DockPanel.Dock="Bottom" x:Name="TimelineScroll" Orientation="Horizontal" Scroll="OnTimelineScroll" />
                <Border DockPanel.Dock="Top" BorderBrush="#444" BorderThickness="0,0,0,2" MaxHeight="140"
                        Visibility="{Binding ShowOverview, Converter={StaticResource BoolToVisibility}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="#1E1F22">
                        <c:TimelineView x:Name="OverviewTimeline" Compact="True"
                                        Project="{Binding Project}"
                                        Playhead="{Binding PlayheadFrame}"
                                        SelectedClipId="{Binding SelectedClipId}"
                                        Snapping="{Binding Snapping}" />
                    </ScrollViewer>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="#1E1F22">
                    <c:TimelineView x:Name="Timeline"
                                    Project="{Binding Project}"
                                    Playhead="{Binding PlayheadFrame}"
                                    SelectedClipId="{Binding SelectedClipId}"
                                    Snapping="{Binding Snapping}"
                                    TrimMode="{Binding TrimMode}" />
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
