<Window x:Class="MovieWorker.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MovieWorker.App.ViewModels"
        xmlns:c="clr-namespace:MovieWorker.App.Controls"
        Title="{Binding WindowTitle}" Width="1440" Height="900" MinWidth="1000" MinHeight="650"
        WindowStartupLocation="CenterScreen" AllowDrop="True">
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewProjectCommand}" />
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenProjectCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveProjectCommand}" />
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveProjectAsCommand}" />
        <KeyBinding Key="I" Modifiers="Control" Command="{Binding ImportFilesCommand}" />
        <KeyBinding Key="E" Modifiers="Control" Command="{Binding ExportCommand}" />
        <KeyBinding Key="E" Modifiers="Control+Shift" Command="{Binding ExportStillCommand}" />
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />
    </Window.InputBindings>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Datei">
                <MenuItem Header="_Neues Projekt" InputGestureText="Strg+N" Command="{Binding NewProjectCommand}" />
                <MenuItem Header="Projekt ö_ffnen …" InputGestureText="Strg+O" Command="{Binding OpenProjectCommand}" />
                <MenuItem Header="_Zuletzt geöffnet" ItemsSource="{Binding RecentProjects}" Click="OnRecentClick">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem">
                            <Setter Property="Header" Value="{Binding}" />
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <Separator />
                <MenuItem Header="_Speichern" InputGestureText="Strg+S" Command="{Binding SaveProjectCommand}" />
                <MenuItem Header="Speichern _unter …" InputGestureText="Strg+Umschalt+S" Command="{Binding SaveProjectAsCommand}" />
                <Separator />
                <MenuItem Header="Dateien _importieren …" InputGestureText="Strg+I" Command="{Binding ImportFilesCommand}" />
                <MenuItem Header="Speicher_karte importieren …" Command="{Binding ImportCardCommand}" />
                <Separator />
                <MenuItem Header="_Exportieren …" InputGestureText="Strg+E" Command="{Binding ExportCommand}" />
                <MenuItem Header="Einzel_bild exportieren …" InputGestureText="Strg+Umschalt+E" Command="{Binding ExportStillCommand}" />
                <Separator />
                <MenuItem Header="_Projekteinstellungen …" Command="{Binding EditProjectSettingsCommand}" />
                <Separator />
                <MenuItem Header="_Beenden" Click="OnExitClick" />
            </MenuItem>
            <MenuItem Header="_Bearbeiten">
                <MenuItem Header="_Rückgängig" InputGestureText="Strg+Z" Command="{Binding UndoCommand}" />
                <MenuItem Header="_Wiederholen" InputGestureText="Strg+Y" Command="{Binding RedoCommand}" />
                <Separator />
                <MenuItem Header="Am Abspielkopf _teilen" InputGestureText="Strg+B" Command="{Binding SplitAtPlayheadCommand}" />
                <MenuItem Header="Clip _löschen" InputGestureText="Entf" Command="{Binding DeleteSelectedClipCommand}" />
                <MenuItem Header="Löschen und Lücke _schließen" InputGestureText="Umschalt+Entf" Command="{Binding RippleDeleteSelectedClipCommand}" />
                <Separator />
                <MenuItem Header="_In-Marke setzen" InputGestureText="I" Command="{Binding MarkInCommand}" />
                <MenuItem Header="_Out-Marke setzen" InputGestureText="O" Command="{Binding MarkOutCommand}" />
                <MenuItem Header="Marken _entfernen" InputGestureText="Strg+Umschalt+X" Command="{Binding ClearMarksCommand}" />
                <Separator />
                <MenuItem Header="_Einrasten" InputGestureText="N" IsCheckable="True" IsChecked="{Binding Snapping}" />
                <MenuItem Header="Videospur hinzufügen" Command="{Binding AddVideoTrackCommand}" />
                <Separator />
                <MenuItem Header="Neuer _Ordner im Medienpool …" Command="{Binding NewBinCommand}" />
                <MenuItem Header="Externen Ton _automatisch synchronisieren" Command="{Binding AutoSyncAllCommand}" />
                <MenuItem Header="Tonspur hinzufügen" Command="{Binding AddAudioTrackCommand}" />
            </MenuItem>
            <MenuItem Header="_Schnitt">
                <MenuItem Header="_Einfügen (Ripple)" InputGestureText="F9" Click="OnEditMenu" Tag="Insert" />
                <MenuItem Header="Ü_berschreiben" InputGestureText="F10" Click="OnEditMenu" Tag="Overwrite" />
                <MenuItem Header="E_rsetzen" InputGestureText="F11" Click="OnEditMenu" Tag="Replace" />
                <MenuItem Header="_Oben platzieren" InputGestureText="F12" Click="OnEditMenu" Tag="PlaceOnTop" />
                <MenuItem Header="_Anhängen" InputGestureText="Umschalt+F12" Click="OnEditMenu" Tag="Append" />
                <Separator />
                <MenuItem Header="_Quellband" IsCheckable="True" IsChecked="{Binding SourceTapeMode}" />
                <MenuItem Header="_Doppel-Timeline" IsCheckable="True" IsChecked="{Binding ShowOverview}" />
            </MenuItem>
            <MenuItem Header="_Wiedergabe">
                <MenuItem Header="Abspielen / Pause" InputGestureText="Leertaste" Click="OnPlayPause" />
                <MenuItem Header="Rückwärts / Stopp / Vorwärts" InputGestureText="J / K / L" IsEnabled="False" />
                <Separator />
                <MenuItem Header="Vorschau mit _Proxys" IsCheckable="True" IsChecked="{Binding UseProxies}" />
                <MenuItem Header="Proxys beim Import _automatisch erstellen" IsCheckable="True" IsChecked="{Binding AutoCreateProxies}" />
                <MenuItem Header="Proxy für Auswahl erstellen" Command="{Binding CreateProxyForSelectedCommand}" />
                <MenuItem Header="Alle fehlenden Proxys erstellen" Command="{Binding CreateAllProxiesCommand}" />
            </MenuItem>
            <MenuItem Header="_Extras">
                <MenuItem Header="_FFmpeg-Ordner festlegen …" Command="{Binding SetFfmpegFolderCommand}" />
            </MenuItem>
            <MenuItem Header="_Hilfe">
                <MenuItem Header="_Kameraprofile" Command="{Binding ShowCameraProfilesCommand}" />
                <MenuItem Header="Ü_ber MovieWorker" Command="{Binding ShowAboutCommand}" />
            </MenuItem>
        </Menu>

        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button Content="Speicherkarte importieren" Command="{Binding ImportCardCommand}" />
                <Button Content="Dateien importieren" Command="{Binding ImportFilesCommand}" />
                <Separator />
                <Button Content="Speichern" Command="{Binding SaveProjectCommand}" />
                <Button Content="Exportieren" FontWeight="SemiBold" Command="{Binding ExportCommand}" />
                <Separator />
                <Button Content="↶" ToolTip="Rückgängig (Strg+Z)" Command="{Binding UndoCommand}" />
                <Button Content="↷" ToolTip="Wiederholen (Strg+Y)" Command="{Binding RedoCommand}" />
            </ToolBar>
        </ToolBarTray>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" />
            </StatusBarItem>
            <StatusBarItem Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <ProgressBar Width="140" Height="12" Maximum="1" Value="{Binding BusyProgress}" />
                    <TextBlock Margin="6,0,0,0" Text="{Binding BusyText}" />
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding ProjectSettingsText}" />
                    <TextBlock Margin="12,0,0,0" Text="{Binding DurationText, StringFormat='Länge {0}'}" />
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="200" />
                <RowDefinition Height="5" />
                <RowDefinition Height="300" MinHeight="150" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="200" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" MinWidth="300" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="340" MinWidth="220" />
            </Grid.ColumnDefinitions>

            <!-- Medienpool -->
            <DockPanel Grid.Row="0" Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Margin="8,6,8,2" FontWeight="SemiBold" Text="Medienpool" />
                <StackPanel DockPanel.Dock="Top" Margin="6,0,6,4">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="🗑" Width="26" Margin="2,0,0,0" ToolTip="Ordner löschen" Command="{Binding DeleteBinCommand}" />
                        <Button DockPanel.Dock="Right" Content="✎" Width="26" Margin="2,0,0,0" ToolTip="Ordner umbenennen" Command="{Binding RenameBinCommand}" />
                        <Button DockPanel.Dock="Right" Content="+" Width="26" Margin="2,0,0,0" ToolTip="Neuer Ordner" Command="{Binding NewBinCommand}" />
                        <ComboBox ItemsSource="{Binding Bins}" SelectedItem="{Binding SelectedBin}" ToolTip="Ordner" />
                    </DockPanel>
                    <DockPanel Margin="0,4,0,0">
                        <TextBlock DockPanel.Dock="Left" Text="🔍" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Suchen in Name, Schlagwörtern, Notizen, Szene und Take" />
                    </DockPanel>
                    <UniformGrid Columns="3" Margin="0,4,0,0">
                        <ComboBox ItemsSource="{Binding KindFilters}" SelectedIndex="{Binding KindFilter}" Margin="0,0,2,0" />
                        <ComboBox ItemsSource="{Binding RatingFilters}" SelectedIndex="{Binding MinRatingFilter}" Margin="1,0" />
                        <ComboBox ItemsSource="{Binding SortModes}" SelectedIndex="{Binding SortMode}" Margin="2,0,0,0" ToolTip="Sortierung" />
                    </UniformGrid>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="6">
                    <Button Content="In Timeline einfügen" Padding="8,2" Command="{Binding AddSelectedToTimelineCommand}" />
                    <Button Content="Proxy" Padding="8,2" Margin="6,0,0,0" ToolTip="Proxy für flüssige Vorschau erstellen"
                            Command="{Binding CreateProxyForSelectedCommand}" />
                    <Button Content="Entfernen" Padding="8,2" Margin="6,0,0,0" Command="{Binding RemoveSelectedMediaCommand}" />
                </StackPanel>
                <Grid>
                    <ListBox x:Name="MediaList" ItemsSource="{Binding MediaView}" SelectedItem="{Binding SelectedMedia}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="OnMediaDoubleClick"
                             PreviewMouseLeftButtonDown="OnMediaMouseDown" PreviewMouseMove="OnMediaMouseMove">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:MediaItemViewModel}">
                                <Grid Margin="2,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="128" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="120" Height="68" Background="#222" CornerRadius="2">
                                        <Grid>
                                            <TextBlock Text="{Binding KindIcon}" Foreground="#888" FontSize="22"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                                            <Border Background="#B0000000" HorizontalAlignment="Right" VerticalAlignment="Bottom" Padding="3,0">
                                                <TextBlock Text="{Binding DurationText}" Foreground="White" FontSize="10" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding CameraLabel}" FontSize="11" Foreground="#555" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Stars}" FontSize="11" Foreground="#C88A00" />
                                            <TextBlock Text="{Binding SceneTakeText}" FontSize="11" Foreground="#555" Margin="6,0,0,0" />
                                            <TextBlock Text=" 🔗" FontSize="11" ToolTip="Mit externem Ton synchronisiert"
                                                       Visibility="{Binding HasSync, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                        <WrapPanel Margin="0,2,0,0">
                                            <Border Style="{StaticResource Badge}" Background="#FFE9C8"
                                                    Visibility="{Binding HasSpecialTransfer, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="{Binding TransferLabel}" FontSize="10" Foreground="#8A4B00" />
                                            </Border>
                                            <Border Style="{StaticResource Badge}" Background="#DDE8FF"
                                                    Visibility="{Binding IsHighFrameRate, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="Zeitlupe" FontSize="10" Foreground="#24489A" />
                                            </Border>
                                            <Border Style="{StaticResource Badge}" Background="#DFF3E4"
                                                    Visibility="{Binding HasProxy, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="Proxy" FontSize="10" Foreground="#1E6B35" />
                                            </Border>
                                        </WrapPanel>
                                        <ProgressBar Height="4" Maximum="1" Value="{Binding ProxyProgress}" Margin="0,3,0,0"
                                                     Visibility="{Binding IsProxyRunning, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="Speicherkarte importieren oder Dateien hierher ziehen."
                               Style="{StaticResource Hint}" Margin="20" TextAlignment="Center" VerticalAlignment="Center"
                               IsHitTestVisible="False" x:Name="EmptyPoolHint" />
                </Grid>
            </DockPanel>

            <GridSplitter Grid.Row="0" Grid.Column="1" Width="5" HorizontalAlignment="Stretch" />

            <!-- Monitore -->
            <Grid Grid.Row="0" Grid.Column="2" x:Name="MonitorHost" Background="#111">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <c:SourceMonitor x:Name="SourceMonitor" Grid.Column="0" />
                <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#333" />
                <c:ProgramMonitor x:Name="ProgramMonitor" Grid.Column="2" />
            </Grid>

            <GridSplitter Grid.Row="0" Grid.Column="3" Width="5" HorizontalAlignment="Stretch" />

            <!-- Inspektor -->
            <TabControl Grid.Row="0" Grid.Column="4" x:Name="Inspector">
                <TabItem Header="Clip" x:Name="ClipTab">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <TextBlock Text="Klicke einen Clip in der Timeline an." Style="{StaticResource Hint}" Margin="8"
                                       Visibility="{Binding SelectedClip, Converter={StaticResource NullToVisibility}, ConverterParameter=invert}" />
                            <StackPanel Margin="8" DataContext="{Binding SelectedClip}"
                                        Visibility="{Binding Converter={StaticResource NullToVisibility}}">
                                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding TrackName}" Style="{StaticResource Hint}" />
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Anfang" Foreground="#666" />
                                    <TextBlock Grid.Column="1" Text="{Binding StartText}" FontFamily="Consolas" />
                                    <TextBlock Grid.Row="1" Text="Ende" Foreground="#666" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding EndText}" FontFamily="Consolas" />
                                    <TextBlock Grid.Row="2" Text="Länge" Foreground="#666" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LengthText}" FontFamily="Consolas" />
                                    <TextBlock Grid.Row="3" Text="Aus Quelle" Foreground="#666" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SourceText}" />
                                </Grid>

                                <TextBlock Text="Geschwindigkeit" Style="{StaticResource SectionHeader}" />
                                <ComboBox ItemsSource="{Binding SpeedChoices}" SelectedItem="{Binding SelectedSpeed}" />
                                <Button Content="{Binding ConformText}" Margin="0,4,0,0" Padding="6,2" HorizontalAlignment="Left"
                                        Command="{Binding ConformCommand}"
                                        Visibility="{Binding CanConform, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="{Binding LastError}" Foreground="#B03030" TextWrapping="Wrap"
                                           Visibility="{Binding LastError, Converter={StaticResource NullToVisibility}}" />

                                <TextBlock Text="Ton" Style="{StaticResource SectionHeader}" />
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Width="60" TextAlignment="Right"
                                               Text="{Binding VolumeDb, StringFormat='{}{0:+0.0;-0.0;0.0} dB'}" />
                                    <Slider Minimum="-40" Maximum="12" Value="{Binding VolumeDb}" SmallChange="0.5" LargeChange="3"
                                            IsEnabled="{Binding HasAudio}" />
                                </DockPanel>
                                <CheckBox Content="Ton stumm" IsChecked="{Binding AudioMuted}" IsEnabled="{Binding HasAudio}" Margin="0,4,0,0" />

                                <TextBlock Text="Blenden (Sekunden)" Style="{StaticResource SectionHeader}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition /><RowDefinition />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Einblenden" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Margin="0,2" Text="{Binding FadeInSeconds, UpdateSourceTrigger=LostFocus}" />
                                    <TextBlock Grid.Row="1" Text="Ausblenden" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,2" Text="{Binding FadeOutSeconds, UpdateSourceTrigger=LostFocus}" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Export" x:Name="ExportTab">
                    <DockPanel Margin="6">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                            <Button Content="Neuer Export …" Padding="8,2" Command="{Binding ExportCommand}" />
                            <Button Content="Erledigte entfernen" Padding="8,2" Margin="6,0,0,0" Command="{Binding ClearFinishedExportsCommand}" />
                        </StackPanel>
                        <Grid>
                            <TextBlock Text="Noch keine Exporte. „Exportieren“ (Strg+E) legt einen Auftrag an; mehrere Aufträge laufen nacheinander."
                                       Style="{StaticResource Hint}" Margin="4" x:Name="EmptyQueueHint" />
                            <ItemsControl ItemsSource="{Binding ExportQueue.Jobs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ExportJobViewModel}">
                                        <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="3" Padding="6" Margin="0,0,0,6" Background="White">
                                            <StackPanel>
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding StateText}" Foreground="#555" />
                                                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                                <TextBlock Text="{Binding PresetName}" FontSize="11" Foreground="#666" TextTrimming="CharacterEllipsis" />
                                                <ProgressBar Height="8" Maximum="1" Value="{Binding Progress}" Margin="0,4,0,2" />
                                                <TextBlock Text="{Binding Detail}" FontSize="11" TextWrapping="Wrap" />
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <Button Content="Abbrechen" Padding="6,0"
                                                            Command="{Binding DataContext.CancelExportCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisibility}}" />
                                                    <Button Content="Im Ordner zeigen" Padding="6,0"
                                                            Command="{Binding DataContext.ShowExportInFolderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            Visibility="{Binding IsFinished, Converter={StaticResource BoolToVisibility}}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </DockPanel>
                </TabItem>
                <TabItem Header="Aufnahme">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8" DataContext="{Binding SelectedMedia}"
                                    Visibility="{Binding Converter={StaticResource NullToVisibility}}">
                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Summary}" Style="{StaticResource Hint}" />

                            <TextBlock Text="Ordnen" Style="{StaticResource SectionHeader}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Ordner" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" Margin="0,2"
                                          ItemsSource="{Binding DataContext.TargetBins, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedItem="{Binding DataContext.SelectedMediaBin, RelativeSource={RelativeSource AncestorType=Window}}" />
                                <TextBlock Grid.Row="1" Text="Bewertung" VerticalAlignment="Center" />
                                <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,2" SelectedIndex="{Binding Rating}">
                                    <ComboBoxItem Content="☆☆☆☆☆  keine" />
                                    <ComboBoxItem Content="★☆☆☆☆" />
                                    <ComboBoxItem Content="★★☆☆☆" />
                                    <ComboBoxItem Content="★★★☆☆" />
                                    <ComboBoxItem Content="★★★★☆" />
                                    <ComboBoxItem Content="★★★★★" />
                                </ComboBox>
                                <TextBlock Grid.Row="2" Text="Szene / Take" VerticalAlignment="Center" />
                                <UniformGrid Grid.Row="2" Grid.Column="1" Columns="2" Margin="0,2">
                                    <TextBox Text="{Binding Scene, UpdateSourceTrigger=LostFocus}" Margin="0,0,2,0" ToolTip="Szene" />
                                    <TextBox Text="{Binding Take, UpdateSourceTrigger=LostFocus}" Margin="2,0,0,0" ToolTip="Take" />
                                </UniformGrid>
                                <TextBlock Grid.Row="3" Text="Schlagwörter" VerticalAlignment="Center" />
                                <TextBox Grid.Row="3" Grid.Column="1" Margin="0,2" Text="{Binding KeywordsText, UpdateSourceTrigger=LostFocus}"
                                         ToolTip="Mit Komma trennen, z. B.: Hochzeit, Kirche, Ringe" />
                                <TextBlock Grid.Row="4" Text="Notizen" VerticalAlignment="Top" Margin="0,4,0,0" />
                                <TextBox Grid.Row="4" Grid.Column="1" Margin="0,2" MinHeight="48" TextWrapping="Wrap" AcceptsReturn="True"
                                         Text="{Binding Notes, UpdateSourceTrigger=LostFocus}" />
                            </Grid>

                            <StackPanel Visibility="{Binding IsAudioOnly, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                                <TextBlock Text="Externer Ton (Rekorder)" Style="{StaticResource SectionHeader}" />
                                <TextBlock Text="{Binding SyncText}" TextWrapping="Wrap" />
                                <DockPanel Margin="0,4,0,0">
                                    <Button DockPanel.Dock="Right" Content="Synchronisieren" Padding="6,1" Margin="4,0,0,0"
                                            Command="{Binding DataContext.SyncSelectedCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    <ComboBox ItemsSource="{Binding DataContext.AudioMediaItems, RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedItem="{Binding DataContext.SelectedSyncAudio, RelativeSource={RelativeSource AncestorType=Window}}"
                                              DisplayMemberPath="Name" ToolTip="Tonaufnahme wählen, die zur selben Szene gehört" />
                                </DockPanel>
                                <StackPanel Visibility="{Binding HasSync, Converter={StaticResource BoolToVisibility}}" Margin="0,4,0,0">
                                    <CheckBox Content="Kameraton beim Einfügen stummschalten" IsChecked="{Binding ReplaceCameraAudio}" />
                                    <Button Content="Verknüpfung lösen" HorizontalAlignment="Left" Padding="6,1" Margin="0,4,0,0"
                                            Command="{Binding DataContext.RemoveSyncCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Text="Kamera" Style="{StaticResource SectionHeader}" />
                            <ComboBox ItemsSource="{Binding CameraChoices}" SelectedItem="{Binding SelectedCamera}" />
                            <TextBlock Text="{Binding CameraLabel}" Style="{StaticResource Hint}" Margin="0,2,0,0" />

                            <TextBlock Text="Hinweise für den Schnitt" Style="{StaticResource SectionHeader}"
                                       Visibility="{Binding HasHints, Converter={StaticResource BoolToVisibility}}" />
                            <Border Background="#FFF6DC" Padding="6" CornerRadius="3"
                                    Visibility="{Binding HasHints, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding HintsText}" TextWrapping="Wrap" />
                            </Border>

                            <TextBlock Text="Technische Daten" Style="{StaticResource SectionHeader}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Länge" Foreground="#666" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DurationText}" />
                                <TextBlock Grid.Row="1" Text="Kennlinie" Foreground="#666" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TransferLabel}" />
                                <TextBlock Grid.Row="2" Text="Größe" Foreground="#666" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SizeText}" />
                                <TextBlock Grid.Row="3" Text="Aufgenommen" Foreground="#666" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding CreatedText}" />
                                <TextBlock Grid.Row="4" Text="Datei(en)" Foreground="#666" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding PartsText}" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="5" Text="Ordner" Foreground="#666" />
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding FolderText}" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="6" Text="Proxy" Foreground="#666" />
                                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding ProxyText}" />
                            </Grid>

                            <TextBlock Text="Tipps zu dieser Kamera" Style="{StaticResource SectionHeader}" />
                            <TextBlock Text="{Binding CameraTipsText}" Style="{StaticResource Hint}" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <GridSplitter Grid.Row="1" Grid.ColumnSpan="5" Height="5" HorizontalAlignment="Stretch" />

            <!-- Timeline -->
            <DockPanel Grid.Row="2" Grid.ColumnSpan="5" x:Name="TimelineHost">
                <ToolBar DockPanel.Dock="Top" ToolBarTray.IsLocked="True">
                    <TextBlock Text="{Binding PlayheadText}" FontFamily="Consolas" FontSize="15" VerticalAlignment="Center" Margin="4,0,12,0" />
                    <Button Content="Teilen" ToolTip="Am Abspielkopf teilen (Strg+B)" Command="{Binding SplitAtPlayheadCommand}" />
                    <Button Content="Löschen" ToolTip="Clip löschen (Entf)" Command="{Binding DeleteSelectedClipCommand}" />
                    <Button Content="Lücke schließen" ToolTip="Löschen und Lücke schließen (Umschalt+Entf)" Command="{Binding RippleDeleteSelectedClipCommand}" />
                    <Separator />
                    <Button Content="In" ToolTip="In-Marke (I)" Command="{Binding MarkInCommand}" />
                    <Button Content="Out" ToolTip="Out-Marke (O)" Command="{Binding MarkOutCommand}" />
                    <Button Content="Marken weg" Command="{Binding ClearMarksCommand}" />
                    <Separator />
                    <ToggleButton Content="Einrasten" ToolTip="An Schnittpunkten einrasten (N)" IsChecked="{Binding Snapping}" />
                    <Separator />
                    <Button Content="−" ToolTip="Verkleinern (−)" Click="OnZoomOut" Width="24" />
                    <Button Content="+" ToolTip="Vergrößern (+)" Click="OnZoomIn" Width="24" />
                    <Button Content="Einpassen" ToolTip="Ganze Timeline zeigen (Umschalt+Z)" Click="OnZoomFit" />
                    <Separator />
                    <ToggleButton Content="Doppel-Timeline" ToolTip="Übersicht der ganzen Timeline über der Detailansicht"
                                  IsChecked="{Binding ShowOverview}" />
                    <Separator />
                    <Button Content="+ Videospur" Command="{Binding AddVideoTrackCommand}" />
                    <Button Content="+ Tonspur" Command="{Binding AddAudioTrackCommand}" />
                </ToolBar>
                <ScrollBar DockPanel.Dock="Bottom" x:Name="TimelineScroll" Orientation="Horizontal" Scroll="OnTimelineScroll" />
                <Border DockPanel.Dock="Top" BorderBrush="#444" BorderThickness="0,0,0,2" MaxHeight="140"
                        Visibility="{Binding ShowOverview, Converter={StaticResource BoolToVisibility}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="#1E1F22">
                        <c:TimelineView x:Name="OverviewTimeline" Compact="True"
                                        Project="{Binding Project}"
                                        Playhead="{Binding PlayheadFrame}"
                                        SelectedClipId="{Binding SelectedClipId}"
                                        Snapping="{Binding Snapping}" />
                    </ScrollViewer>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="#1E1F22">
                    <c:TimelineView x:Name="Timeline"
                                    Project="{Binding Project}"
                                    Playhead="{Binding PlayheadFrame}"
                                    SelectedClipId="{Binding SelectedClipId}"
                                    Snapping="{Binding Snapping}" />
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
