<Window x:Class="MovieWorker.App.Views.ImportCardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Speicherkarte importieren" Width="720" Height="560" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Karte oder Ordner" FontWeight="SemiBold" />
            <DockPanel Margin="0,4,0,0">
                <Button DockPanel.Dock="Right" Content="Durchsuchen …" Padding="8,2" Margin="6,0,0,0"
                        Command="{Binding BrowseSourceCommand}" IsEnabled="{Binding IsIdle}" />
                <Button DockPanel.Dock="Right" Content="Aktualisieren" Padding="8,2" Margin="6,0,0,0"
                        Command="{Binding RefreshCardsCommand}" IsEnabled="{Binding IsIdle}" />
                <ComboBox ItemsSource="{Binding Cards}" SelectedItem="{Binding SourceFolder}" IsEnabled="{Binding IsIdle}" />
            </DockPanel>
            <TextBlock Text="{Binding SummaryText}" Foreground="#555" Margin="0,4,0,0" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom">
            <CheckBox Content="Dateien auf die Festplatte kopieren (empfohlen – danach kann die Karte wieder in die Kamera)"
                      IsChecked="{Binding CopyFiles}" IsEnabled="{Binding IsIdle}" Margin="0,8,0,0" />
            <Grid Margin="20,6,0,0" IsEnabled="{Binding DestinationEnabled}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition /><RowDefinition /><RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock Text="Zielordner" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Text="{Binding DestinationFolder, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsIdle}" />
                <Button Grid.Column="2" Content="…" Width="30" Margin="6,0,0,0" Command="{Binding BrowseDestinationCommand}" IsEnabled="{Binding IsIdle}" />
                <TextBlock Grid.Row="1" Text="Unterordner" VerticalAlignment="Center" Margin="0,4,0,0" />
                <TextBox Grid.Row="1" Grid.Column="1" Margin="0,4,0,0" Text="{Binding CameraFolder, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsIdle}" />
                <CheckBox Grid.Row="2" Grid.Column="1" Margin="0,6,0,0" Content="Jede Kopie per Prüfsumme (SHA-256) kontrollieren"
                          IsChecked="{Binding VerifyChecksums}" IsEnabled="{Binding IsIdle}" />
            </Grid>
            <TextBlock Margin="20,4,0,0" Foreground="#666" TextWrapping="Wrap"
                       Text="Ablage: Zielordner\Datum\Unterordner\Datei. Bereits vorhandene Dateien werden übersprungen." />
            <ProgressBar Height="14" Margin="0,10,0,0" Maximum="1" Value="{Binding Progress}" />
            <TextBlock Text="{Binding StatusText}" Margin="0,4,0,0" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="Importieren" Width="110" IsDefault="True" Command="{Binding StartCommand}" />
                <Button Content="Abbrechen" Width="110" Margin="8,0,0,0" IsCancel="True" Command="{Binding CancelCommand}" />
            </StackPanel>
        </StackPanel>

        <ListView ItemsSource="{Binding Files}" Margin="0,8,0,0">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Datei" Width="220" DisplayMemberBinding="{Binding Name}" />
                    <GridViewColumn Header="Größe" Width="90" DisplayMemberBinding="{Binding SizeText}" />
                    <GridViewColumn Header="Pfad" Width="320" DisplayMemberBinding="{Binding Path}" />
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
